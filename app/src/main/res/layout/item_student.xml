<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="14dp"
    app:cardCornerRadius="18dp"
    app:cardElevation="4dp"
    app:cardBackgroundColor="#FFFFFF">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="17dp">

        <!-- Student Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:gravity="center"
                android:text="&#128100;"
                android:textSize="25sp"
                android:background="#CCFBF1" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="13dp">

                <TextView
                    android:id="@+id/tvStudentName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Student Name"
                    android:textColor="#172B4D"
                    android:textSize="17sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvStudentEmail"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="student@email.com"
                    android:textColor="#718096"
                    android:textSize="12sp"
                    android:layout_marginTop="4dp" />

            </LinearLayout>

        </LinearLayout>

        <!-- Divider -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#E8EEF0"
            android:layout_marginTop="14dp"
            android:layout_marginBottom="12dp" />

        <!-- Phone -->
        <TextView
            android:id="@+id/tvStudentPhone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Phone: 9876543210"
            android:textColor="#475569"
            android:textSize="13sp"
            android:layout_marginBottom="7dp" />

        <!-- Department -->
        <TextView
            android:id="@+id/tvStudentDepartment"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Department: Computer Science"
            android:textColor="#475569"
            android:textSize="13sp" />

        <!-- Action Buttons -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="end"
            android:layout_marginTop="15dp">

            <Button
                android:id="@+id/btnEditStudent"
                android:layout_width="95dp"
                android:layout_height="42dp"
                android:text="Edit"
                android:textAllCaps="false"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:backgroundTint="#0F766E"
                android:minWidth="0dp" />

            <Button
                android:id="@+id/btnDeleteStudent"
                android:layout_width="95dp"
                android:layout_height="42dp"
                android:text="Delete"
                android:textAllCaps="false"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:backgroundTint="#DC2626"
                android:minWidth="0dp"
                android:layout_marginStart="10dp" />

        </LinearLayout>

    </LinearLayout>

</androidx.cardview.widget.CardView>
