<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F3F7F8"
    android:padding="20dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="STUDENT DIRECTORY"
        android:textColor="#0F766E"
        android:textSize="12sp"
        android:textStyle="bold"
        android:letterSpacing="0.15"
        android:layout_marginTop="20dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="All Students"
        android:textColor="#172B4D"
        android:textSize="27sp"
        android:textStyle="bold"
        android:layout_marginTop="8dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="View and manage your student records."
        android:textColor="#718096"
        android:textSize="14sp"
        android:layout_marginTop="5dp" />

    <!-- Student Count -->
    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="65dp"
        android:layout_marginTop="22dp"
        app:cardCornerRadius="15dp"
        app:cardElevation="2dp"
        app:cardBackgroundColor="#E0F2F1">

        <TextView
            android:id="@+id/tvStudentCount"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:paddingStart="18dp"
            android:text="Total Students: 0"
            android:textColor="#0F766E"
            android:textSize="16sp"
            android:textStyle="bold" />

    </androidx.cardview.widget.CardView>

    <!-- Search Bar -->
    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="55dp"
        android:layout_marginTop="18dp"
        android:layout_marginBottom="12dp"
        app:cardCornerRadius="14dp"
        app:cardElevation="2dp"
        app:cardBackgroundColor="#FFFFFF">

        <EditText
            android:id="@+id/etSearchStudent"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:hint="Search student by name..."
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:textSize="14sp"
            android:textColor="#172B4D"
            android:textColorHint="#94A3B8"
            android:background="@android:color/transparent"
            android:inputType="text"
            android:singleLine="true" />

    </androidx.cardview.widget.CardView>

    <!-- Empty State -->
    <TextView
        android:id="@+id/tvEmptyMessage"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="No students found"
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="#64748B"
        android:gravity="center"
        android:visibility="gone"
        android:padding="20dp" />

    <!-- Student List -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerViewStudents"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingBottom="8dp" />

    <!-- Add Student Button -->
    <Button
        android:id="@+id/btnAddStudentFromList"
        android:layout_width="match_parent"
        android:layout_height="55dp"
        android:text=" + Add New Student"
        android:textSize="15sp"
        android:textStyle="bold"
        android:textAllCaps="false"
        android:textColor="#FFFFFF"
        android:backgroundTint="#0F766E"
        android:layout_marginTop="10dp" />

</LinearLayout>
