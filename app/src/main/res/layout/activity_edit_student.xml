<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F3F7F8"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="22dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="STUDENT DETAILS"
            android:textColor="#0F766E"
            android:textSize="12sp"
            android:textStyle="bold"
            android:letterSpacing="0.15"
            android:layout_marginTop="22dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Edit Student"
            android:textColor="#172B4D"
            android:textSize="27sp"
            android:textStyle="bold"
            android:layout_marginTop="9dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Update the student's information below."
            android:textColor="#718096"
            android:textSize="14sp"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="24dp" />

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="20dp"
            app:cardElevation="4dp"
            app:cardBackgroundColor="#FFFFFF">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Personal Information"
                    android:textColor="#172B4D"
                    android:textSize="17sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="18dp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Full Name"
                    android:textColor="#475569"
                    android:textStyle="bold"
                    android:textSize="13sp" />

                <EditText
                    android:id="@+id/etEditName"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="7dp"
                    android:layout_marginBottom="17dp"
                    android:hint="Enter student name"
                    android:padding="13dp"
                    android:textSize="14sp"
                    android:singleLine="true"
                    android:inputType="textPersonName"
                    android:backgroundTint="#CBD5E1" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Email Address"
                    android:textColor="#475569"
                    android:textStyle="bold"
                    android:textSize="13sp" />

                <EditText
                    android:id="@+id/etEditEmail"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="7dp"
                    android:layout_marginBottom="17dp"
                    android:hint="Enter email address"
                    android:padding="13dp"
                    android:textSize="14sp"
                    android:singleLine="true"
                    android:inputType="textEmailAddress"
                    android:backgroundTint="#CBD5E1" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Phone Number"
                    android:textColor="#475569"
                    android:textStyle="bold"
                    android:textSize="13sp" />

                <EditText
                    android:id="@+id/etEditPhone"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="7dp"
                    android:layout_marginBottom="17dp"
                    android:hint="Enter 10-digit phone number"
                    android:padding="13dp"
                    android:textSize="14sp"
                    android:singleLine="true"
                    android:inputType="phone"
                    android:maxLength="10"
                    android:backgroundTint="#CBD5E1" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Department"
                    android:textColor="#475569"
                    android:textStyle="bold"
                    android:textSize="13sp" />

                <EditText
                    android:id="@+id/etEditDepartment"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="7dp"
                    android:layout_marginBottom="22dp"
                    android:hint="Enter department"
                    android:padding="13dp"
                    android:textSize="14sp"
                    android:singleLine="true"
                    android:inputType="textCapWords"
                    android:backgroundTint="#CBD5E1" />

                <Button
                    android:id="@+id/btnUpdateStudent"
                    android:layout_width="match_parent"
                    android:layout_height="54dp"
                    android:text="Save Changes"
                    android:textAllCaps="false"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="#FFFFFF"
                    android:backgroundTint="#0F766E" />

            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="STUDENT MANAGEMENT SYSTEM"
            android:textColor="#94A3B8"
            android:textSize="10sp"
            android:textStyle="bold"
            android:gravity="center"
            android:letterSpacing="0.15"
            android:layout_marginTop="28dp"
            android:layout_marginBottom="18dp" />

    </LinearLayout>
</ScrollView>
